# Porta do serviço accounts
ACCOUNTS_SERVICE_PORT=3001

# Porta do serviço records
RECORDS_SERVICE_PORT=3002

# URL do serviço web
# essa variavel é lida pelos serviços accounts e records, não define em que porta o Next opera.
# Para isso é necessário passar a opção "-p PORTA" nos scripts do package.json do para alterar a
# porta padrão e redefinir essa variável abaixo para que os serviços possam ler o valor correto. 
FRONTEND_URL='http://localhost:3000'

# URL do serviço accounts lida pelo Next
NEXT_PUBLIC_API_URL='http://localhost:3001'

# URL do serviço records lida pelo Next
NEXT_PUBLIC_RECORDS_API_URL='http://localhost:3002'