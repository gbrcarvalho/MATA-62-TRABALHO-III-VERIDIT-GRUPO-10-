# ============================================================
# Veridit — .gitignore
# Raiz do monorepo
# ============================================================

# Node.js / JavaScript / TypeScript
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*
npm-debug.log*
.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Saídas de build e compilação
dist/
build/
out/
*.tsbuildinfo

# Cache de ferramentas
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.vite/
.turbo/

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example
!.env.*.example

# Certificados, chaves e credenciais locais
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
.secrets/

# Next.js
.next/
.vercel/
.next-turbo/
next-env.d.ts
/out/

# production
/build

# env files (can opt-in for committing if needed)
.env*

# Testes e cobertura
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Prisma
# Mantenha schema.prisma e migrations versionados.
# Ignore somente bancos locais usados em testes.
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs e arquivos temporários
logs/
*.log
*.log.*
tmp/
temp/
.temp/
*.tmp
*.swp
*.swo
*.bak

# Docker — arquivos locais de override e estado
# Não ignore Dockerfile nem docker-compose.yml.
docker-compose.override.yml
docker-compose.local.yml
*.pid

# VS Code — preserve configurações compartilháveis
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.vscode/

# Outras IDEs
.idea/
*.iml

# Sistemas operacionais
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Artefatos gerados
*.tgz
*.tar.gz
*.zip
*.heapprofile
*.cpuprofile

# Arquivos locais do projeto
.local/
.local-*/
